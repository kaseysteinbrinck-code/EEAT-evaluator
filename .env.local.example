# Anthropic API key (claude-sonnet-5)
ANTHROPIC_API_KEY=

# Shared passcode gating the whole app (single shared code, per project decision)
PASSCODE=

# Secret used to sign the session cookie issued after a correct passcode.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Upstash Redis (used for rate limiting) -- create a free database at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits (optional -- defaults shown)
RATE_LIMIT_PER_IP=12
RATE_LIMIT_GLOBAL=250
EEAT_MAX_RESEARCH_LOOKUPS=15
